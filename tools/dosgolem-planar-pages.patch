diff --git a/internal/dos/planar_bios_page_test.go b/internal/dos/planar_bios_page_test.go
new file mode 100644
index 0000000..794e35f
--- /dev/null
+++ b/internal/dos/planar_bios_page_test.go
@@ -0,0 +1,89 @@
+package dos
+
+import (
+	"bytes"
+	"fmt"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+// Contract: 8sword docs/spec/001-planar-bios-display-pages.md.
+// Distinct page pixels test the visible result independently of BIOS bookkeeping.
+func TestBIOSLowResolutionPlanarDisplayPages(t *testing.T) {
+	for _, tc := range []struct {
+		mode  uint8
+		size  uint16
+		pages uint8
+	}{
+		{0x0d, 0x2000, 8}, {0x0e, 0x4000, 4},
+	} {
+		t.Run(fmt.Sprintf("mode-%02x", tc.mode), func(t *testing.T) {
+			m, d := newTest(t)
+			call(m, d, 0x10, uint16(tc.mode))
+			if m.Read16(0x44c) != tc.size {
+				t.Fatalf("page size=%04x want=%04x", m.Read16(0x44c), tc.size)
+			}
+			for page := uint8(0); page < tc.pages; page++ {
+				// Every page has a different color at its first pixel.
+				for plane := 0; plane < 4; plane++ {
+					if (page+1)&(1<<plane) != 0 {
+						m.VGA.Planes[plane][int(page)*int(tc.size)] = 0x80
+					}
+				}
+			}
+			original := append([]byte(nil), m.VGA.Raw()...)
+			for page := uint8(0); page < tc.pages; page++ {
+				call(m, d, 0x10, 0x0500|uint16(page))
+				if m.Read8(0x462) != page || m.Read16(0x44e) != uint16(page)*tc.size {
+					t.Fatalf("page %d not represented in BDA", page)
+				}
+				_, _, px := m.Planar()
+				if px[0] != page+1 {
+					t.Fatalf("visible page %d first pixel=%d want=%d", page, px[0], page+1)
+				}
+				call(m, d, 0x10, 0x0f00)
+				if uint8(m.CPU.R[cpu.BX]>>8) != page {
+					t.Fatalf("AH0F BH does not report page %d", page)
+				}
+			}
+			call(m, d, 0x10, 0x0500|uint16(tc.pages))
+			if m.Read8(0x462) != tc.pages-1 {
+				t.Fatal("invalid page changed the active page")
+			}
+			if !bytes.Equal(original, m.VGA.Raw()) {
+				t.Fatal("page selection changed VRAM")
+			}
+			call(m, d, 0x10, 0x0500)
+			_, _, px := m.Planar()
+			if px[0] != 1 {
+				t.Fatal("switching back did not preserve page zero")
+			}
+			call(m, d, 0x10, 0x0501)
+			call(m, d, 0x10, uint16(tc.mode))
+			if m.Read8(0x462) != 0 || m.Read16(0x44e) != 0 || m.VGA.DisplayStart() != 0 {
+				t.Fatal("mode reset left stale display page")
+			}
+		})
+	}
+}
+
+func TestBIOSPlanarDisplayPageSurvivesMachineState(t *testing.T) {
+	m, d := newTest(t)
+	call(m, d, 0x10, 0x000e)
+	m.VGA.Planes[2][0x4000] = 0x80
+	call(m, d, 0x10, 0x0501)
+	var saved bytes.Buffer
+	if err := m.SaveState(&saved); err != nil {
+		t.Fatal(err)
+	}
+	restored := machine.New()
+	if err := restored.LoadState(bytes.NewReader(saved.Bytes())); err != nil {
+		t.Fatal(err)
+	}
+	_, _, px := restored.Planar()
+	if px[0] != 4 || restored.Read8(0x462) != 1 || restored.Read16(0x44e) != 0x4000 {
+		t.Fatal("state lost visible page or BDA bookkeeping")
+	}
+}
