diff --git a/internal/machine/bios_page.go b/internal/machine/bios_page.go
new file mode 100644
index 0000000..540ddbd
--- /dev/null
+++ b/internal/machine/bios_page.go
@@ -0,0 +1,30 @@
+package machine
+
+// SetBIOSPlanarPage implements INT 10h AH=05h for standard modes 0Dh/0Eh.
+// Contract: 8sword docs/spec/001-planar-bios-display-pages.md.
+// This changes scanout and BIOS bookkeeping, never the stored plane bytes.
+// Other video modes and nonstandard CRTC addressing remain outside this slice.
+func (m *Machine) SetBIOSPlanarPage(page uint8) bool {
+	var size uint16
+	var pages uint8
+	switch m.VideoMode() {
+	case 0x0D:
+		size, pages = 0x2000, 8
+	case 0x0E:
+		size, pages = 0x4000, 4
+	default:
+		return false
+	}
+	if page >= pages {
+		return false
+	}
+	start := uint16(page) * size
+	m.Write16(bdaSeg*16+0x4E, start)
+	m.Write8(bdaSeg*16+0x62, page)
+	base := m.Read16(bdaSeg*16 + 0x63)
+	m.Out8(base, 0x0C)
+	m.Out8(base+1, uint8(start>>8))
+	m.Out8(base, 0x0D)
+	m.Out8(base+1, uint8(start))
+	return true
+}
